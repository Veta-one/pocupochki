# Сервер
NODE_ENV=development
PORT=3000

# MongoDB
MONGO_URI=mongodb://admin:your_password@mongo:27017/pocupochki_db?authSource=admin

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_bot_token_here

# OpenRouter API
OPENROUTER_API_KEY=your_openrouter_key_here

# Web App URL
WEBAPP_URL=https://shop.vetaone.site

# Admin Telegram ID (опционально, первый пользователь станет админом)
ADMIN_TELEGRAM_ID=

# JWT Secret (генерируется автоматически если не указан)
JWT_SECRET=
